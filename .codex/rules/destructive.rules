# 기존 PreToolUse 안전 가드를 Codex execpolicy로 이전한다.
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "재귀 강제 삭제는 금지되어 있습니다. 대상 경로를 검증한 뒤 안전한 삭제 방식을 사용하세요.",
    match = ["rm -rf build"],
    not_match = ["rm file.txt"],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "원격 이력을 덮어쓰지 마세요. 필요한 경우 사용자와 안전한 대안을 논의하세요.",
    match = ["git push --force origin main"],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "작업 트리 변경을 파괴하지 마세요. 비파괴적인 Git 명령을 사용하세요.",
    match = ["git reset --hard HEAD"],
    not_match = ["git reset HEAD file.txt"],
)
